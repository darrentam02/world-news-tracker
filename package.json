{
  "name": "world-news-tracker",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "pnpm --filter @world-news/app build",
    "dev": "pnpm --filter @world-news/app dev",
    "fetch-hourly": "tsx scripts/fetch-hourly.ts",
    "cluster": "tsx scripts/cluster.ts",
    "quotes": "tsx scripts/fetch-quotes.ts",
    "digest-a": "tsx scripts/send-digest.ts --slot=a",
    "digest-b": "tsx scripts/send-digest.ts --slot=b",
    "cleanup-pending": "tsx scripts/cleanup-pending.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "dotenv": "^16.6.1",
    "fast-xml-parser": "^5.11.1"
  }
}