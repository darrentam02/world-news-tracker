# Replit Secrets（Production）= 生產用；本地 dev 抄一份做 .env
# 私人：subscriber email 只入 Supabase，永遠唔准入 Git / .env.example 只放名字
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM=             # 例：news@你的domain（要先喺 Resend verify domain）
PUBLIC_BASE_URL=         # 例：https://你的replit.app —— confirm/unsubscribe link 用
LLM_API_KEY=           # GitHub Models 優先；DeepSeek 後備
LLM_MODEL=deepseek-chat
DIGEST_SECRET=         # POST /api/digest 用嘅 secret 鑰
PORT=5000